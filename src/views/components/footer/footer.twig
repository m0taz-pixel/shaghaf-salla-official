{% set is_ar = theme.is_rtl %}

<footer data-testid="store-footer" class="store-footer shaghaf-footer">
  <div class="shaghaf-footer__glow" aria-hidden="true"></div>

  <div aria-label="footer" class="store-footer__inner">
    <div class="container">
      <div class="shaghaf-footer__brand-row">
        <a href="{{ link('/') }}" class="shaghaf-footer__brand" aria-label="{{ store.name }}">
          <span class="shaghaf-footer__logo">
            <img src="{{ store.logo|cdn(180) }}" width="180" height="72" loading="lazy" alt="{{ store.name }} logo">
          </span>
          <span class="shaghaf-footer__brand-copy">
            <strong>{{ store.name }}</strong>
            <small>{{ is_ar ? 'رحلتك الدراسية إلى ماليزيا، بخطوات أوضح.' : 'Your study journey to Malaysia, made clearer.' }}</small>
          </span>
        </a>

        <div class="shaghaf-footer__trust">
          <salla-trust-badges data-testid="store-footer-trust-badges" dark></salla-trust-badges>
        </div>
      </div>

      <div class="shaghaf-footer__grid">
        <div class="shaghaf-footer__about">
          <h3>{{ is_ar ? 'عن شغف' : 'About Shaghaf' }}</h3>
          {% if store.description %}
            <div class="shaghaf-footer__description">{{ store.description|raw }}</div>
          {% else %}
            <p class="shaghaf-footer__description">
              {{ is_ar
                ? 'نساعدك على مقارنة خيارات الدراسة وترتيب القبول والتأشيرة والسكن حتى تبدأ رحلتك بصورة أوضح.'
                : 'We help you compare study options and organise admission, visa and housing for a clearer start.'
              }}
            </p>
          {% endif %}
          <salla-social data-testid="store-footer-social" class="shaghaf-footer__social"></salla-social>
        </div>

        <nav class="shaghaf-footer__nav" aria-label="{{ is_ar ? 'أقسام الصفحة الرئيسية' : 'Homepage sections' }}">
          <h3>{{ is_ar ? 'رحلتك مع شغف' : 'Your Shaghaf journey' }}</h3>
          <ul>
            <li><a href="{{ link('/') }}#services">{{ is_ar ? 'خدماتنا' : 'Services' }}</a></li>
            <li><a href="{{ link('/') }}#institutes">{{ is_ar ? 'معاهد اللغة' : 'Language institutes' }}</a></li>
            <li><a href="{{ link('/') }}#universities">{{ is_ar ? 'الجامعات' : 'Universities' }}</a></li>
            <li><a href="{{ link('/') }}#steps">{{ is_ar ? 'خطوات الدراسة' : 'Study steps' }}</a></li>
            <li><a href="{{ link('/') }}#faq">{{ is_ar ? 'الأسئلة الشائعة' : 'FAQ' }}</a></li>
          </ul>
        </nav>

        <div class="shaghaf-footer__links">
          <h3>{{ is_ar ? 'روابط مهمة' : 'Useful links' }}</h3>
          <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
        </div>

        <div class="shaghaf-footer__contact">
          <h3>{{ is_ar ? 'تواصل معنا' : 'Contact us' }}</h3>
          <salla-contacts data-testid="store-footer-contacts"></salla-contacts>

          {% if store.settings.tax.number %}
            <div class="shaghaf-footer__tax">
              {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" aria-label="{{ trans('common.elements.tax_number') }}">
                  <img width="40" height="50" src="{{ 'images/tax.png' | cdn(70, 70) }}" loading="lazy" alt="{{ trans('common.elements.tax_number') }}">
                </a>
              {% endif %}
              <div>
                <small>{{ trans('common.elements.tax_number') }}</small>
                <strong>{{ store.settings.tax.number }}</strong>
              </div>
            </div>

            {% if store.settings.tax.certificate %}
              <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                <div class="flex justify-center max-w-full">
                  <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ trans('common.elements.tax_number') }}">
                </div>
              </salla-modal>
            {% endif %}
          {% endif %}
        </div>
      </div>

      <div class="shaghaf-footer__apps">
        <salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
      </div>
    </div>
  </div>

  <div class="shaghaf-footer__bottom container">
    <span class="copyright-text">{% hook copyright %}</span>
    <salla-payments data-testid="store-footer-payments"></salla-payments>
  </div>

  <span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span>
</footer>
