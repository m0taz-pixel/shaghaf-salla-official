{% set is_ar = theme.is_rtl %}
{% set questions = is_ar ? [
  {
    question: 'هل تساعدونني في اختيار الجامعة أو معهد اللغة؟',
    answer: 'نعم. نبدأ بفهم تخصصك ومستواك وميزانيتك والموعد الذي تستهدفه، ثم نرتّب لك خيارات قابلة للمقارنة بدل قائمة طويلة غير مخصّصة.'
  },
  {
    question: 'ما المستندات التي أحتاجها للبدء؟',
    answer: 'تختلف حسب المرحلة والجهة التعليمية. عادةً نبدأ بجواز السفر والشهادات وكشوف الدرجات، ثم نرسل لك قائمة دقيقة بعد مراجعة حالتك.'
  },
  {
    question: 'كم تستغرق إجراءات القبول؟',
    answer: 'المدة تعتمد على المعهد أو الجامعة واكتمال المستندات وموعد التقديم. بعد مراجعة ملفك نوضح لك نطاقاً زمنياً واقعياً لكل مرحلة.'
  },
  {
    question: 'هل تتابعون إجراءات التأشيرة الطلابية؟',
    answer: 'نساعدك في ترتيب المتطلبات ومتابعة الخطوات والتحديثات المرتبطة بالطلب. القرار النهائي ومدة المعالجة يظلان لدى الجهات الرسمية المختصة.'
  },
  {
    question: 'هل تساعدون في السكن والاستقبال؟',
    answer: 'نساعدك على تقييم خيارات السكن المتاحة وترتيب احتياجات الوصول وفق مدينتك وموعدك، مع بقاء الاختيار النهائي حسب التوافر وتفضيلاتك.'
  },
  {
    question: 'متى يُفضّل أن أبدأ؟',
    answer: 'كلما بدأت مبكراً كان لديك وقت أفضل للمقارنة وتجهيز المستندات. أرسل موعد الدراسة المتوقع وسنساعدك في بناء جدول مناسب.'
  }
] : [
  {
    question: 'Can you help me choose a university or language institute?',
    answer: 'Yes. We begin with your subject, level, budget and target date, then organise a comparable shortlist instead of sending a long generic list.'
  },
  {
    question: 'Which documents do I need to begin?',
    answer: 'Requirements vary by study level and institution. We usually begin with your passport, certificates and transcripts, then provide a precise list after reviewing your case.'
  },
  {
    question: 'How long does admission take?',
    answer: 'Timing depends on the institution, document readiness and intake. Once we review your file, we explain a realistic time range for each stage.'
  },
  {
    question: 'Do you support the student visa process?',
    answer: 'We help organise requirements and follow the application steps and updates. Final approval and processing times remain with the relevant authorities.'
  },
  {
    question: 'Can you help with accommodation and arrival?',
    answer: 'We help you assess available accommodation and plan arrival needs around your city and date, with final selection subject to availability and preference.'
  },
  {
    question: 'When should I start?',
    answer: 'Starting early gives you more time to compare options and prepare documents. Share your expected intake and we will help build a suitable timeline.'
  }
] %}

<section id="faq" class="shaghaf-section shaghaf-faq" data-testid="store-home-faq">
  <div class="container">
    <div class="shaghaf-faq__layout">
      <aside class="shaghaf-faq__intro">
        <span class="shaghaf-eyebrow">
          <span class="shaghaf-eyebrow__dot"></span>
          {{ is_ar ? 'الأسئلة الشائعة' : 'Frequently asked questions' }}
        </span>
        <h2 class="shaghaf-section__title">
          {{ is_ar ? 'إجابات واضحة قبل أن تبدأ' : 'Clear answers before you begin' }}
        </h2>
        <p class="shaghaf-section__lead">
          {{ is_ar
            ? 'جمعنا الأسئلة التي تساعدك على تكوين صورة أولية عن الرحلة.'
            : 'A practical starting point for understanding your study journey.'
          }}
        </p>

        <div class="shaghaf-faq__contact">
          <span class="shaghaf-faq__contact-icon">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 12a8.5 8.5 0 0 1-9 8.5A9.7 9.7 0 0 1 8 19.6L3 21l1.4-4A8.5 8.5 0 1 1 21 12Z"/><path d="M8.5 11.8h.01M12 11.8h.01M15.5 11.8h.01"/></svg>
          </span>
          <div>
            <strong>{{ is_ar ? 'سؤالك غير موجود؟' : 'Still have a question?' }}</strong>
            <a href="/pages/contact-us">{{ is_ar ? 'تحدّث مع مستشار شغف' : 'Talk to a Shaghaf adviser' }}</a>
          </div>
        </div>
      </aside>

      <div class="shaghaf-faq__list">
        {% for item in questions %}
          <details class="shaghaf-faq-item" name="shaghaf-faq" {{ loop.first ? 'open' : '' }}>
            <summary>
              <span>{{ item.question }}</span>
              <i aria-hidden="true"></i>
            </summary>
            <div class="shaghaf-faq-item__answer">
              <p>{{ item.answer }}</p>
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
